# Containerfile.yolo — image for running Claude Code agents with permissions
# disabled ("yolo") inside a rootless Podman container. See yolo-run.sh.
#
# Base is pinned by digest (resolve a new one with pin-digest.sh, or
# `podman pull REF && podman image inspect --format '{{.Digest}}' REF`).
FROM docker.io/library/node:24-bookworm-slim@sha256:0e2646ab57e77b7a384a0cb59b6815b182c77e1f9c3ba36bd8435bd9c4e6680e

ARG CLAUDE_CODE_VERSION=latest
# Set to 1 to add Chromium for browser-based local debug/testing (+~400MB).
ARG WITH_BROWSER=0

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      git ca-certificates curl jq ripgrep less procps unzip \
      build-essential python3 python3-pip python3-venv \
 && if [ "$WITH_BROWSER" = "1" ]; then \
      apt-get install -y --no-install-recommends chromium fonts-liberation; \
    fi \
 && rm -rf /var/lib/apt/lists/*

RUN npm install -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
 && npm cache clean --force

# Runs as the image's non-root "node" user (uid/gid 1000). yolo-run.sh bind-mounts
# a persistent home over /home/node and keeps the root filesystem read-only, so
# user-level installs go to ~/.local and ~/.npm-global.
ENV HOME=/home/node \
    NPM_CONFIG_PREFIX=/home/node/.npm-global \
    PATH=/home/node/.npm-global/bin:/home/node/.local/bin:$PATH \
    CHROME_BIN=/usr/bin/chromium \
    DISABLE_AUTOUPDATER=1
USER node
WORKDIR /home/node
CMD ["claude", "--dangerously-skip-permissions"]
